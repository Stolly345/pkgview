# Build env: Debian 12 = oldest target, so the .deb's glibc/GTK deps work on Debian 12 and Ubuntu 24.04+.
FROM debian:12
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates build-essential pkg-config libgtk-4-dev dpkg-dev xvfb \
 && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal -c clippy,rustfmt \
 && cargo install cargo-deb --locked && chmod -R a+rwX /opt/cargo /opt/rustup
